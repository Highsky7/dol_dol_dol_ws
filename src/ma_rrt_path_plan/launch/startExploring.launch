<?xml version="1.0"?>
<launch>
    <!-- RRT Path Planning 노드 -->
    <node pkg="ma_rrt_path_plan" type="main.py" name="ma_rrt_path_plan_node" output="screen">

        <!-- 웨이포인트 발행 설정 -->
        <param name="desiredWaypointsFrequency"  value="5"    type="int"    />
        <param name="publishWaypoints"            value="true" type="bool"   />

        <!-- 차량 위치를 중심으로 반투명 보라색 구로 표시.
        – 차량으로부터 이 거리(m) 이내에 있는 웨이포인트까지만 저장합니다.
        – 값 증가 시: 더 먼 웨이포인트까지 저장 → 예측 경로 길어짐
        – 값 감소 시: 가까운 웨이포인트만 저장 → 경로 단축, 하지만 멀리 있는 경로 유실
        -->
        <param name="maxDistToSaveWaypoints"  value="2.0"  type="double"/>

        <!-- 각 콘 위치에 노란색 구로 표시.
        – 콘 하나를 반지름 몇 미터로 간주할지 설정합니다.
        – 값 증가 시: 콘 간격이 넓어져 더 보수적으로 회피 경로 생성 → 안전 마진 증가
        – 값 감소 시: 콘이 작아져 더 근접해서 빠른 경로 생성 가능하나 충돌 위험 증가
        -->
        <param name="coneObstacleSize"  value="0.7"  type="double"/>

        <!--
        – 압축된 벽 점군을 장애물로 처리할 때 사용할 반지름 값입니다.
        – 값 증가 시: 벽을 더 두껍게 간주 → 벽에 더 멀리 떨어진 경로 생성
        – 값 감소 시: 벽을 얇게 간주 → 벽에 더 가까운 경로 허용, 단 벽 충돌 위험 증가
        -->
        <param name="wallObstacleRadius" value="0.01" type="double"/>

        <!--
        – 노드 간 단계별 이동(스텝) 간격입니다.
        – 값 증가 시: 더 큰 스텝으로 빠르게 넓은 영역 탐색 → 경로가 거칠어질 수 있음
        – 값 감소 시: 더 작은 스텝으로 세밀한 경로 생성 → 연산량 증가
        -->
        <param name="expandDistance"    value="0.6"  type="double"/>

        <!--
        – 새로운 노드를 생성할 때 허용하는 최대 각도(도) 범위입니다.
        – 값 증가 시: 더 넓은 각도로 분기 → 다양한 방향 탐색
        – 값 감소 시: 방향 변화가 제한 → 직선에 가까운 경로 위주
        -->
        <param name="expandAngle"       value="20"   type="double"/>

        <!--
        – RRT 알고리즘의 최대 반복 횟수입니다.
        – 값 증가 시: 탐색 반복 횟수 증가 → 해를 찾을 확률 상승하나 계산량 증가
        – 값 감소 시: 빠르게 종료하나 해를 못 찾을 가능성 상승
        -->
        <param name="iterationNumber"   value="100"  type="int"/>

        <!-- 차량 위치를 중심으로 반투명 녹색 구로 표시.
        – 리프 노드 평가 시 콘 장애물까지 고려하는 최대 거리(미터)입니다.
        – 값 증가 시: 먼 거리 콘까지 평가해 점수 계산 → 장애물 분포 반영 범위↑
        – 값 감소 시: 가까운 콘만 평가 → 계산량↓, 멀리 있는 장애물 간과 가능
        -->
        <param name="coneDistLimit"     value="4.0"  type="double"/>

        <!-- 벽 포인트에 빨간색 구로 표시 (벽 장애물 반지름 포함).
        – 벽 장애물 반지름에 추가로 더할 안전 여유(m)입니다.
        – 값 증가 시: 벽과 더 큰 거리를 유지 → 안정성↑
        – 값 감소 시: 벽에 더 근접 허용 → 경로 폭 좁아짐, 위험↑
        -->
        <param name="wallSafetyMargin"  value="0.1"  type="double"/>

        <!--
        – 벽 근접 시 경로 점수에서 차감할 페널티 계수입니다.
        – 값 증가 시: 벽 근접 시 페널티 강화 → 벽에서 멀어지는 경로 유도
        – 값 감소 시: 페널티 완화 → 벽 근접 허용 경로 증가
        -->
        <param name="penalty_factor"    value="5.0"  type="double"/>

        <!--
        – 한 번에 저장할 웨이포인트 최대 개수입니다.
        – 값 증가 시: 더 많은 웨이포인트 저장 → 경로 완전성↑
        – 값 감소 시: 저장 개수 축소 → 메모리 절약, 하지만 경로 불완전 가능성↑
        -->
        <param name="maxWaypointAmountToSave" value="4"    type="int"/>

        <!--
        – 필터링 시 새로 계산된 위치 반영 비율(0.0~1.0)입니다.
        – 값 증가 시: 새 위치 반영 강도↑ → 빠른 적응, 다만 노이즈에 민감
        – 값 감소 시: 부드러운 이동 유지 → 안정적이나 반응 느림
        -->
        <param name="newPointFilter"    value="0.2"  type="double"/>

        <!-- 차량 위치를 중심으로 반투명 주황색 구로 표시.
        – 트리가 한 번에 확장할 수 있는 최대 거리(미터)입니다.
        – 값 증가 시: 한 번에 더 멀리 뻗어나가므로 전체 탐색 영역 확장 속도↑, 다만 세밀도↓
        – 값 감소 시: 세밀한 경로 생성 가능하나 더 많은 노드가 필요 → 느려짐
        -->
        <param name="planDistance"      value="5.0"  type="double"/>


        <!-- 차량 위치를 중심으로 반투명 파란색 구로 표시.
        – 차량 전방 몇 미터 이내의 콘만 RRT 트리 생성에 포함할지 결정합니다. 
        – 값 증가 시: 더 먼 거리에 있는 콘까지 장애물로 인식 → 장애물 수 증가로 경로 탐색이 느려질 수 있으나, 더 넓은 시야 확보
        – 값 감소 시: 가까운 콘만 고려 → 경로 탐색 속도는 빨라지나, 먼 거리에 있는 장애물을 간과할 수 있음
        -->
        <param name="frontConesDist"    value="12.0" type="double"/>

    </node>


    <!-- Pure Pursuit 노드 (변경 없음) -->
    <node pkg="ma_rrt_path_plan" type="ma_rrt_purepursuit.py" name="ma_rrt_purepursuit_node" output="screen" />

    <!-- Car Visualizer 노드: 시각화용 파라미터만 남김 -->
    <node pkg="ma_rrt_path_plan" type="car_visual.py" name="car_visual_node" output="screen">
        <param name="frame_id"          type="string" value="velodyne" />
        <param name="x_min"             type="double" value="-0.1"      />
        <param name="x_max"             type="double" value="1.1"       />
        <param name="y_min"             type="double" value="-0.35"     />
        <param name="y_max"             type="double" value="0.35"      />
        <param name="publish_frequency" type="double" value="10.0"      />
    </node>

    <!-- RViz 실행 -->
    <node pkg="rviz" type="rviz" name="rviz_node"
          args="-d $(find ma_rrt_path_plan)/launch/gps_lidar_tf.rviz"
          output="screen" />
</launch>
